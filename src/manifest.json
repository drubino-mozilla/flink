{
    "manifest_version": 2,
    "name": "Flink",
    "version": "1.2.8",
    "browser_specific_settings": {
        "gecko": {
            "id": "flink@joivid.com",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "permissions": ["activeTab", "clipboardWrite", "contextMenus", "tabs"],
    "background": {
        "scripts": ["background.js"]
    },
    "page_action": {
        "default_title": "Copy link to clipboard",
        "default_icon": {
            "19": "images/flink-19.png",
            "38": "images/flink-38.png",
            "96": "images/flink-96.png"
        }
    },
    "icons": {
        "96": "images/flink-96.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}
